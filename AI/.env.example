AI_SERVICE_NAME=KLTN AI Service
AI_DEBUG=false

# Default local model
LOCAL_LLM_MODEL=qwen2.5:3b

# Semantic embedding model
SEMANTIC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Valid values: template | ollama | openai | gemini
COVER_LETTER_PROVIDER=gemini
CHATBOT_PROVIDER=gemini
MOCK_INTERVIEW_PROVIDER=gemini
CAREER_REPORT_PROVIDER=gemini
CV_BUILDER_WRITING_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_BUDGET=0

# Ollama fallback/local
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=8

# Token limits
CHATBOT_MAX_TOKENS=180
MOCK_INTERVIEW_MAX_TOKENS=220
CAREER_REPORT_MAX_TOKENS=900
COVER_LETTER_MAX_TOKENS=750
CV_BUILDER_WRITING_MAX_TOKENS=650

# OpenAI legacy provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses
